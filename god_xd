tog(Tabs.Move,"🚀 บิน (Fly)",function(on)
    S.Fly=on
    local char=LP.Character
    if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    pcall(function()
        if hrp:FindFirstChild("NB") then hrp.NB:Destroy() end
        if hrp:FindFirstChild("NG") then hrp.NG:Destroy() end
    end)

    if on then
        if hum then hum.PlatformStand=true end
        FlyVel=newInst("BodyVelocity",{
            Name="NB",
            MaxForce=Vector3.new(1e9,1e9,1e9),
            Velocity=Vector3.zero,
            Parent=hrp
        })
        FlyGyro=newInst("BodyGyro",{
            Name="NG",
            MaxTorque=Vector3.new(1e9,1e9,1e9),
            P=3000,
            D=500,
            CFrame=hrp.CFrame,
            Parent=hrp
        })

        task.spawn(function()
            while S.Fly and hrp and hrp.Parent do
                task.wait()
                pcall(function()
                    local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                    if not hm or not FlyVel or not FlyGyro then return end

                    local cf = Cam.CFrame
                    local move = hm.MoveDirection

                    if move.Magnitude > 0.05 then
                        local dir = (cf.LookVector * -move.Z + cf.RightVector * move.X)
                        if dir.Magnitude > 0 then
                            FlyVel.Velocity = dir.Unit * S.FlyVal
                        end
                    else
                        FlyVel.Velocity = FlyVel.Velocity * 0.8
                    end

                    FlyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + cf.LookVector)
                end)
            end
        end)
    else
        if hum then hum.PlatformStand=false end
        FlyVel=nil
        FlyGyro=nil
    end
end)
