local function sld(parent,text,mn,mx,def,cb)
    local f=newInst("Frame",{
        Size=UDim2.new(1,-4,0,42),
        BackgroundColor3=Color3.fromRGB(20,20,26),
        BorderSizePixel=0,
        ZIndex=4,
        Parent=parent
    })
    corner(7,f)
    local lbl=newInst("TextLabel",{
        Size=UDim2.new(1,-8,0,18),
        Position=UDim2.new(0,6,0,3),
        Text=text..": "..def,
        TextColor3=Color3.fromRGB(200,200,200),
        BackgroundTransparency=1,
        Font=Enum.Font.SourceSans,
        TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=5,
        Parent=f
    })
    local bg=newInst("Frame",{
        Size=UDim2.new(0.9,0,0,6),
        Position=UDim2.new(0.05,0,1,-11),
        BackgroundColor3=Color3.fromRGB(38,38,46),
        BorderSizePixel=0,
        ZIndex=5,
        Parent=f
    })
    corner(3,bg)
    local fill=newInst("Frame",{
        Size=UDim2.new((def-mn)/(mx-mn),0,1,0),
        BackgroundColor3=Color3.fromRGB(200,0,35),
        BorderSizePixel=0,
        ZIndex=6,
        Parent=bg
    })
    corner(3,fill)
    local drag=false
    local function upd(x)
        local r=math.clamp((x-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(r,0,1,0)
        local v=math.floor(mn+(mx-mn)*r)
        lbl.Text=text..": "..v
        pcall(cb,v)
    end
    bg.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            drag=false
        end
    end)
end

