RunService.Heartbeat:Connect(function()
    pcall(function()
        local char=LP.Character
        if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid")
        local hrp=char:FindFirstChild("HumanoidRootPart")

        if S.Speed and hum then hum.WalkSpeed=S.SpeedVal end

        if S.Jump and hum then
            hum.UseJumpPower=true
            hum.JumpPower=S.JumpVal
        end

        if S.Noclip or S.Fling then
            for _,v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end

        if S.AirWalk and hrp then
            if not AirPart or not AirPart.Parent then
                AirPart = newInst("Part",{
                    Name = "NAMO_Air",
                    Size = Vector3.new(6, 1, 6),
                    Anchored = true,
                    Transparency = 1,
                    CanCollide = true,
                    Parent = WS
                })
            end
            local y = AirWalkY or (hrp.Position.Y - 3)
            AirPart.CFrame = CFrame.new(hrp.Position.X, y, hrp.Position.Z)
        elseif not S.AirWalk and AirPart then
            AirPart:Destroy()
            AirPart = nil
            AirWalkY = nil
        end

        if S.KillAura and hrp then
            local tool=char:FindFirstChildOfClass("Tool")
            for _,p in pairs(Players:GetPlayers()) do
                if p\~=LP and p.Character then
                    local pHRP=p.Character:FindFirstChild("HumanoidRootPart")
                    if pHRP and (pHRP.Position-hrp.Position).Magnitude<=S.AuraRange then
                        hrp.CFrame=pHRP.CFrame*CFrame.new(0,0,-2.5)
                        if tool then
                            pcall(function()
                                local re=tool:FindFirstChildOfClass("RemoteEvent")
                                if re then re:FireServer() end
                            end)
                        end
                    end
                end
            end
        end

        if S.Aimbot then
            local cl,mn=nil,math.huge
            for _,p in pairs(Players:GetPlayers()) do
                if p\~=LP and p.Character then
                    local pH=p.Character:FindFirstChild("HumanoidRootPart")
                    local pM=p.Character:FindFirstChildOfClass("Humanoid")
                    if pH and pM and pM.Health>0 then
                        local d=(pH.Position-(hrp and hrp.Position or Vector3.zero)).Magnitude
                        if d<mn then mn=d; cl=p end
                    end
                end
            end
            if cl and cl.Character and cl.Character:FindFirstChild("HumanoidRootPart") then
                Cam.CFrame=Cam.CFrame:Lerp(
                    CFrame.new(Cam.CFrame.Position,cl.Character.HumanoidRootPart.Position),
                    S.AimSmooth
                )
            end
        end

        if S.Fling and FlingAV and FlingAV.Parent then
            FlingAV.AngularVelocity = Vector3.new(0, S.FlingSpeed * 40, 0)
        end
    end)
end)

